 const selected=unseen.slice(0,count);
 if(selected.length<count){
  // On recommence un cycle seulement après avoir utilisé les questions disponibles.
  const extras=shuffle(unique.filter(i=>!selected.includes(i)&&!unseen.includes(i)));
  selected.push(...extras.slice(0,count-selected.length));
 }
 if(selected.length<count){alert('Pas assez de questions pour ce thème.');return}
 // L'historique mémorise les questions du cycle actuel, pas seulement la dernière partie.
